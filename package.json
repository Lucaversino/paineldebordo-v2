{
  "name": "painel-de-bordo-supabase-vercel",
  "version": "97.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node prebuild-clean.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "charts:download": "node tools/cartas-marinha/01_baixar_cartas.mjs",
    "charts:extract": "python tools/cartas-marinha/02_extrair_kap.py",
    "charts:convert": "python tools/cartas-marinha/03_converter_kap_para_xyz.py",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win nsis",
    "desktop:pack": "electron-builder --dir",
    "ais:worker": "node worker/aisstream-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "ol": "^10.10.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "@types/ws": "^8.18.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.paineldebordo.pescaindustrial",
    "productName": "Painel de Bordo",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron/**/*",
      "public/favicon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
